# ==== Обязательные параметры ====
# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF_your_token_here

# Telegram ID владельцев через запятую (узнать свой ID: @userinfobot)
OWNER_IDS=123456789

# ==== Необязательные ====
# Чат (группа/канал) для уведомлений модерации. Бот должен быть админом.
MODERATION_CHAT_ID=
# Контакт поддержки, показывается пользователям
SUPPORT_CONTACT=@support
# Путь к базе данных
DB_PATH=data/bot.db
# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
